{
  "manifest_version": 3,
  "name": "YoutubeAdblock",
  "version": "0.5.12",
  "description": "Document-start YouTube ad blocker with no-ad request injection, Object.assign hook, toString-masked proxies, ServiceWorker block, webpack chunk prune, iframe fetch-lift defense, SponsorBlock + Return YouTube Dislike, volume boost, Unhook-style clutter hides, engine health diagnostics, and expanded DNR rules.",
  "author": "SysAdminDoc",
  "homepage_url": "https://github.com/SysAdminDoc/YoutubeAdblock",
  "minimum_chrome_version": "121",
  "action": {
    "default_title": "Open YoutubeAdblock Control Center"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://www.youtube-nocookie.com/*",
    "*://youtubekids.com/*",
    "*://www.youtubekids.com/*",
    "https://raw.githubusercontent.com/SysAdminDoc/YoutubeAdblock/*",
    "https://sponsor.ajay.app/*",
    "https://dearrow-thumb.ajay.app/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://www.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://www.youtubekids.com/*"
      ],
      "js": ["main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://www.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://www.youtubekids.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ytab-network-blocks",
        "enabled": true,
        "path": "rules/network-blocks.json"
      }
    ]
  },
  "commands": {
    "ytab-open-panel": {
      "description": "Open YoutubeAdblock Control Center"
    },
    "ytab-toggle-protection": {
      "description": "Pause or Resume YoutubeAdblock Protection"
    },
    "ytab-refresh-rules": {
      "description": "Refresh YoutubeAdblock Rules"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubeadblock@sysadmindoc.github.io",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}

{
  "manifest_version": 3,
  "name": "YoutubeAdblock (development)",
  "version": "0.8.1",
  "description": "Local YouTube ad blocking with signed rules and an in-page Control Center that explains what is running.",
  "author": "SysAdminDoc",
  "homepage_url": "https://github.com/SysAdminDoc/YoutubeAdblock",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open YoutubeAdblock Control Center",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://www.youtube-nocookie.com/*",
    "*://youtubekids.com/*",
    "*://www.youtubekids.com/*",
    "https://raw.githubusercontent.com/SysAdminDoc/YoutubeAdblock/*"
  ],
  "optional_host_permissions": [
    "https://sponsor.ajay.app/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://www.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://www.youtubekids.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://www.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://www.youtubekids.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ytab-network-blocks",
        "enabled": true,
        "path": "rules/network-blocks.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubeadblock@sysadmindoc.github.io",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
